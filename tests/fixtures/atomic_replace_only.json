    {"id": "new", "project": "P1", "capabilities": [["r", "k"], ["r", "need"]], "cost": 2, "conflicts": ["old"], "requires": []},
    {"id": "extra", "project": "P1", "capabilities": [["r", "need"]], "cost": 7, "conflicts": [], "requires": []}
  ],
  "projects": [
    {
      "id": "P1",
      "required": [["r", "k"], ["r", "need"]],
      "forbidden": [["r", "blocked"]]
    }
  ],
  "replacements": [
    {"remove": "old", "add": "new"}
  ],
  "old_state": ["old"],
  "must_keep": [
    {"project": "P1", "capabilities": [["r", "k"]]}
  ]
